# Copy to .env and fill in from Supabase Dashboard → Project Settings → API.
# These two values are public by design (they ship inside the app); RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key.
EXPO_PUBLIC_SUPABASE_KEY=

# NEVER put the Anthropic key or the service_role key here.
# The Anthropic key is a Supabase secret, used only by Edge Functions:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
